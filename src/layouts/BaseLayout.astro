---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import HeaderLabel from '../components/HeaderLabel.astro';
import HeaderWordmark from '../components/HeaderWordmark.astro';
import MobileMenu from '../components/MobileMenu.astro';
import type { Service } from '../data/services';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  footerCta?: Pick<Service, 'ctaText'>;
  showFooter?: boolean;
  showFooterCta?: boolean;
  bodyClass?: string;
}

const {
  title = 'Studio Schatzi — Gestaltung & Strategie',
  description = 'Studio Schatzi entwickelt unverwechselbare Marken, Kampagnen und digitale Auftritte.',
  image = '/og.png',
  footerCta,
  showFooter = true,
  showFooterCta = true,
  bodyClass,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const navigationLinks = [
  { href: '/projekte', label: 'Projekte', current: pathname.startsWith('/projekte') },
  { href: '/leistungen', label: 'Leistungen', current: pathname.startsWith('/leistungen') },
  { href: '/studio', label: 'Studio', current: pathname === '/studio' },
  { href: '/kontakt', label: 'Kontakt', current: pathname === '/kontakt' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/logo-studio-schatzi.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter fallback="swap" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <div class="page-swipe" transition:persist="page-swipe" aria-hidden="true"></div>
    <header class="site-header">
      <a class="wordmark" data-header-adaptive href="/" aria-label="Studio Schatzi Startseite">
        <HeaderWordmark />
      </a>
      <button class="menu-toggle" type="button" data-menu-toggle data-header-adaptive aria-label="Menü" aria-expanded="false" aria-controls="mobile-navigation" aria-haspopup="dialog" hidden>
        <HeaderLabel text="Menü" />
      </button>
      <nav class="desktop-nav" aria-label="Hauptnavigation">
        <div class="nav-pages">
          {navigationLinks.slice(0, 3).map(({ href, label, current }) => (
            <a data-header-adaptive href={href} aria-label={label} aria-current={current ? 'page' : undefined}><HeaderLabel text={label} /></a>
          ))}
        </div>
        {navigationLinks.slice(3).map(({ href, label, current }) => (
          <a class="nav-contact" data-header-adaptive href={href} aria-label={label} aria-current={current ? 'page' : undefined}><HeaderLabel text={label} /></a>
        ))}
        <span class="nav-indicator" data-nav-indicator transition:persist="nav-indicator" aria-hidden="true"></span>
      </nav>
    </header>
    <MobileMenu links={navigationLinks} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {showFooter && <SiteFooter cta={footerCta} showCta={showFooterCta} />}
    <script>
      import '../scripts/header-contrast';
      import '../scripts/nav-indicator';
      import { initializePageSwipe } from '../scripts/page-swipe';
      import { initializeMobileMenu } from '../scripts/mobile-menu';

      const cleanupSwipe = initializePageSwipe();
      let cleanupMenu = initializeMobileMenu();
      const mountMenu = () => {
        cleanupMenu();
        cleanupMenu = initializeMobileMenu();
      };
      document.addEventListener('astro:after-swap', mountMenu);
      import.meta.hot?.dispose(() => {
        cleanupSwipe();
        cleanupMenu();
        document.removeEventListener('astro:after-swap', mountMenu);
      });
    </script>
  </body>
</html>
