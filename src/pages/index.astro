---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const homeProjects = projects.filter((project) => project.slug !== 'donauwalther');
---

<BaseLayout>
  <section class="hero">
    <h1>Wir geben guten Unternehmen eine Form, die hängen bleibt.</h1>
  </section>

  <section class="home-projects" aria-label="Projekte">
    <div class="home-projects-grid">
      {homeProjects.map((project, index) => <ProjectCard project={project} size={index % 3 === 1 ? 'small' : 'large'} />)}
    </div>
    <a class="text-link archive-link" href="/projekte">Alle Projekte ansehen</a>
  </section>
</BaseLayout>
