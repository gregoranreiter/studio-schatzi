---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteContent } from '../lib/content';

const { contact } = await getSiteContent();
const telephoneHref = `tel:${contact.phone.replace(/[^+\d]/g, '')}`;
const addressLines = contact.address.split('\n');
---

<BaseLayout
  title="Kontakt — Studio Schatzi"
  description={`Studio Schatzi erreichen: ${contact.email}, ${contact.phone}. ${contact.address.replace(/\n/g, ' ')}.`}
  bodyClass="contact-page"
  showFooterCta={false}
>
  <section class="contact-intro" aria-labelledby="contact-title">
    <h1 class="visually-hidden" id="contact-title">Kontakt</h1>
    <address class="contact-details" aria-label="Studio Schatzi Kontakt">
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={telephoneHref}>{contact.phone}</a>
      <p>{addressLines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</p>
      {contact.socialLinks.length > 0 && (
        <ul class="contact-socials" aria-label="Social Media">
          {contact.socialLinks.map((link) => (
            <li><a href={link.url} rel="me noreferrer">{link.label}</a></li>
          ))}
        </ul>
      )}
    </address>
  </section>
</BaseLayout>
