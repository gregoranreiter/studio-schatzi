---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PortableText } from 'astro-portabletext';
import { getSiteContent } from '../lib/content';

const { studio } = await getSiteContent();
---

<BaseLayout title="Studio — Studio Schatzi" description="Studio Schatzi ist ein unabhängiges Studio für Gestaltung und Strategie in Linz.">
  <section class="page-intro studio-intro">
    <h1>{studio.headline}</h1>
  </section>
  <section class="studio-content" aria-label="Über Studio Schatzi">
    {studio.content.map((block) => block._type === 'studioRichTextBlock' ? (
      <div class="studio-content-block studio-content-block--text">
        <PortableText value={block.body} />
      </div>
    ) : (
      <figure class:list={['studio-content-block', 'studio-content-block--image', `studio-content-block--${block.layout}`]}>
        <img
          src={block.image.src}
          srcset={block.image.srcset}
          sizes={block.layout === 'full' ? '100vw' : '(max-width: 760px) 100vw, 75vw'}
          width={block.image.width}
          height={block.image.height}
          alt={block.image.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))}
  </section>
</BaseLayout>
