---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import { getSiteContent, type Project, type Service } from '../../lib/content';

export async function getStaticPaths() {
  const { services } = await getSiteContent();
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service }: Props = Astro.props;
const { projects, contact } = await getSiteContent();
const projectBySlug = new Map(projects.map((project) => [project.slug, project]));
const cases = service.cases.map((item) => ({ ...item, project: projectBySlug.get(item.project) })).filter((item) => item.project) as Array<{ project: Project; text: string }>;
const ctaHref = `mailto:${contact.email}?subject=${encodeURIComponent(service.cta.emailSubject)}`;
---

<BaseLayout title={`${service.title} — Studio Schatzi`} description={service.headline} image={cases[0]?.project.cover.src} bodyClass="service-detail-page" serviceTitle={service.title} showFooterCta={false}>
  <article class="service-detail">
    <header class="service-detail-hero">
      <div class="service-detail-hero__content">
        <h1 class="service-headline">{service.headline}</h1>
      </div>
    </header>

    <div class="service-detail-chapters">
      {service.chapters.map((chapter) => (
        <section class="service-detail-chapter">
          <h2>{chapter.title}</h2>
          <p>{chapter.text}</p>
        </section>
      ))}
    </div>

    <section class="service-cases">
      <h2>{service.casesIntro}</h2>
      <div class="service-case-flow">
        {cases.map(({ project, text }) => (
          <a class="service-case" href={`/projekte/${project.slug}`}>
            <ProjectCover project={project} class="service-case__image" loading="lazy" />
            <div class="service-case__copy">
              <h3>{project.title}</h3>
              <p>{text}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="service-cta" aria-labelledby="service-cta-title">
      <h2 id="service-cta-title">{service.cta.statement}</h2>
      <a class="pill-link service-cta__link" href={ctaHref}>{service.cta.linkLabel}</a>
    </section>
  </article>
</BaseLayout>
