---
import type { Project } from '../data/projects';
import { splitProjectScope } from '../lib/project-scope';

interface Props { project: Project; size?: 'large' | 'small'; class?: string; stackScope?: boolean }
const { project, size = 'large', class: className, stackScope = false } = Astro.props;
const scopeLines = stackScope ? splitProjectScope(project.scope) : [];
---

<a class:list={['project-card', `project-card--${size}`, className]} href={`/projekte/${project.slug}`}>
  <div class="project-card__image" style={{
    '--project-tone': project.tone,
    '--project-image-ratio': project.cardImage?.aspectRatio,
    '--project-image-position': project.cardImage?.position,
  }}>
    <img src={project.cover} alt={project.coverAlt} loading="lazy" />
  </div>
  <div class="project-card__caption">
    <h2>{project.title}</h2>
    <p>{stackScope
      ? scopeLines.map((service, index) => <>{index > 0 && <br />}{service}</>)
      : project.scope}</p>
  </div>
</a>
