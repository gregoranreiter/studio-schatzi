---
import ClientLogos from './ClientLogos.astro';

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
---

<footer class:list={['site-footer', { 'site-footer--compact': !showCta }]} id="kontakt">
  {showCta && (
    <div class="site-footer__cta">
      <a class="pill-link footer-contact-link" href="/kontakt">Kontakt aufnehmen</a>
    </div>
  )}
  <ClientLogos />
  <div class="footer-bottom">
    <!-- Add a destination once the legal text or its approved URL is supplied. -->
    <span class="footer-legal">Imprint &amp; Privacy</span>
    <span>© {new Date().getFullYear()} Studio Schatzi</span>
  </div>
</footer>
