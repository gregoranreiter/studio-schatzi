---
import { services, type Service } from '../data/services';
import ClientLogos from './ClientLogos.astro';

interface Props {
  cta?: Pick<Service, 'ctaText'>;
}

const { cta = services[0] } = Astro.props;
---

<footer class="site-footer" id="kontakt">
  <div class="site-footer__cta">
    <p>{cta.ctaText}</p>
    <address class="footer-contact" aria-label="Kontakt">
      <a href="mailto:post@studioschatzi.at">post@studioschatzi.at</a>
      <a href="tel:+4368110656021">+43 681 10 65 60 21</a>
      <p>Hauptplatz 23,<br />4020 Linz</p>
    </address>
  </div>
  <ClientLogos />
  <div class="footer-bottom">
    <!-- Add a destination once the legal text or its approved URL is supplied. -->
    <span class="footer-legal">Imprint &amp; Privacy</span>
    <span>© {new Date().getFullYear()} Studio Schatzi</span>
  </div>
</footer>
