---
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  class?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'sync' | 'async' | 'auto';
  sizes?: string;
}

const { project, class: className, loading, decoding, sizes = '100vw' } = Astro.props;
---

<div
  class:list={['project-cover', className, { 'project-cover--cropped': project.coverVisibleHeight }]}
  style={{
    '--project-tone': project.tone,
    '--project-image-ratio': project.cardImage?.aspectRatio,
    '--project-image-position': project.cardImage?.position,
    '--project-cover-visible': project.coverVisibleHeight,
  }}
>
  <img
    src={project.cover.src}
    srcset={project.cover.srcset}
    {sizes}
    width={project.cover.width}
    height={project.cover.height}
    alt={project.cover.alt}
    loading={loading}
    decoding={decoding}
  />
</div>
